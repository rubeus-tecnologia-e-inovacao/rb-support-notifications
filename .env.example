# Token do bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# Chave exigida no header x-api-key. Gere uma com: openssl rand -hex 32
API_KEY=troque_por_uma_chave_longa_e_aleatoria

# Porta da API (em PaaS, a plataforma define esse valor sozinha)
PORT=3000

# 127.0.0.1 = apenas a própria máquina 
HOST=127.0.0.1